{
  "name": "youtube-scheduler",
  "productName": "YouTube Scheduler",
  "version": "0.1.0",
  "description": "Schedule recurring YouTube live broadcasts from a browser.",
  "author": "bkntr",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/bkntr/youtube-scheduler.git"
  },
  "homepage": "https://github.com/bkntr/youtube-scheduler",
  "bugs": "https://github.com/bkntr/youtube-scheduler/issues",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "ui:fixtures": "vite",
    "start": "vite preview",
    "typecheck": "svelte-check --tsconfig ./tsconfig.web.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run --root .",
    "test:watch": "vitest --root .",
    "icons": "node scripts/generate-icons.mjs",
    "build": "npm run typecheck && npm test && vite build"
  },
  "dependencies": {
    "@js-temporal/polyfill": "^0.5.1",
    "@lucide/svelte": "^0.544.0",
    "bits-ui": "^2.18.1",
    "svelte": "^5.38.10",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^6.1.4",
    "@tailwindcss/vite": "^4.1.13",
    "@types/node": "^24.3.1",
    "svelte-check": "^4.3.2",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.2",
    "vite": "^7.1.5",
    "vitest": "^3.2.4"
  }
}
